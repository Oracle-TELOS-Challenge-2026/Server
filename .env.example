# Local development: copy to .env at the repository root.
# Shared by Spring's local profile and compose.dev.yaml.
# Use plain KEY=value (no quotes, export, inline comments, or variable expansion).
# For portable local values, use ASCII letters/digits and _ . - : / @ !
ORACLE_PWD=BinTimeAdminLocal123
ORACLE_PORT=1521
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USERNAME=BINTIME_APP
DB_PASSWORD=BinTimeAppLocal123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=BinTimeRedisLocal123

# Kakao REST API key / client secret. Never commit actual values.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/kakao/callback
FRONTEND_URL=http://localhost:5173
# Exact app paths, separated by commas. External URLs are rejected.
AUTH_ALLOWED_RETURN_PATHS=/
