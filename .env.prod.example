# Deployment only: copy to .env on the server, never reuse local credentials.
# compose.yaml reads this file and injects values into the prod application.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Paste the complete OCI-generated TLS JDBC URL here, with no line breaks.
# Use single quotes around values containing $, #, or spaces.
DB_URL=
DB_USERNAME=BINTIME_APP
DB_PASSWORD=

# Generate a separate password, for example: openssl rand -hex 32
REDIS_PASSWORD=

# OpenAI embeddings. Keep the real key only in the untracked .env.
OPENAI_API_KEY=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://frontend-oracle.vercel.app/api/v1/auth/oauth/kakao/callback
# Vercel must proxy /api to the Oracle server before switching these values.
FRONTEND_URL=https://frontend-oracle.vercel.app
AUTH_ALLOWED_RETURN_PATHS=/

# Production Elasticsearch: private Compose network, no published port.
# Generate once: openssl rand -hex 32. Keep this value across container recreations.
ELASTIC_PASSWORD=
SEARCH_ELASTICSEARCH_URL=http://elasticsearch:9200
SEARCH_ELASTICSEARCH_ALIAS=bintime-stores
SEARCH_ELASTICSEARCH_USERNAME=elastic
# Optional full header, for example ApiKey <encoded-key>; overrides Basic auth.
SEARCH_ELASTICSEARCH_AUTHORIZATION=
# Normal operation: process new store/slot events without rebuilding on every restart.
SEARCH_INDEX_REBUILD=false
BINTIME_STORE_EVENT_DELIVERY_ENABLED=true
SEARCH_SCHEDULING_ENABLED=true
# Raw cosine similarity [-1, 1], not a probability. Tune with real demo preferences.
SEARCH_MATCHING_MINIMUM_SIMILARITY=0.5
ES_JAVA_OPTS=-Xms512m -Xmx512m
ES_MEMORY_LIMIT=1g
# Mount the service-account JSON separately at this container path; never commit the key.
FCM_ENABLED=false
FCM_PROJECT_ID=bintime-33512
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/bintime-firebase-admin.json
